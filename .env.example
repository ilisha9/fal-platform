# Optional: your fal API key (https://fal.ai/dashboard/keys).
# You can also paste it in the app under Settings instead.
FAL_KEY=

# Port for the web app (open http://localhost:3000)
PORT=3000

# 127.0.0.1 = only this PC can open the app (recommended).
# Use 0.0.0.0 to allow other devices on your network — anyone who can reach it can spend your fal credits.
HOST=127.0.0.1
